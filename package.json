{
  "name": "lighthouse-scanner",
  "version": "1.0.0",
  "description": "Lighthouse website scanner API server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node index.ts",
    "dev:worker": "ts-node worker.ts",
    "dev:all": "concurrently -n api,worker -c cyan,yellow \"npm run dev\" \"npm run dev:worker\"",
    "scan": "node scripts/scan-to-file.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@types/express-rate-limit": "^5.1.3",
    "bullmq": "^5.78.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lighthouse": "^13.4.0",
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "concurrently": "^10.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
