# Redis connection URL (used by both the API server and the worker)
REDIS_URL=redis://localhost:6379

# Scanner auth — shared secret the backend must send as X-Scanner-Secret header.
# When set, all inbound requests AND outbound callbacks must carry it.
# Leave empty to disable auth (local dev).
SCANNER_SECRET=

# HTTP port for the API server (index.ts). Default: 3000
PORT=3000

# Number of BullMQ jobs the worker processes concurrently. Default: 1
# Note: Lighthouse itself is serialised by an internal mutex regardless of this.
WORKER_CONCURRENCY=1

# How many worker CONTAINERS to run (docker compose deploy.replicas).
# Parallelism comes from replicas, not WORKER_CONCURRENCY — each container is its
# own process (own Chrome) and pulls from the shared queue. Size to ~vCPUs-1 on a
# non-burstable box; keep at 1 on a 2-vCPU/burstable instance for accurate scores.
WORKER_REPLICAS=2

# How many scans a single Chrome instance handles before it's recycled. Default: 10
MAX_SCANS_PER_BROWSER=10

# When "true", callback_url is also run through the SSRF (private-IP) check.
# Default: false (callbacks to private/localhost addresses are allowed).
STRICT_CALLBACK_SSRF=false

# --- S3 offloading ---
# When S3_BUCKET is set: the result JSON is uploaded PRIVATELY and the callback carries a
# presigned `results_url`; screenshots are uploaded as PUBLIC objects under `screenshots/`
# and the results carry permanent public URLs. Leave S3_BUCKET empty to disable
# (results + base64 screenshots are sent inline — local dev default).
S3_BUCKET=
AWS_REGION=us-east-1
# Credentials come from the standard AWS chain (env vars or IAM role):
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# Presigned URL lifetime for the (private) result payload, in seconds. Default: 3600 (1h) —
# the backend fetches it once on callback receipt and stores the result in its DB.
S3_URL_TTL_SECONDS=3600
# Base URL for PUBLIC screenshot objects. Empty → direct S3 endpoint
# (https://<bucket>.s3.<region>.amazonaws.com). Set to a CloudFront domain to use a CDN.
S3_PUBLIC_BASE_URL=
